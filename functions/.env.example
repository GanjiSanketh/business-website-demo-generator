# Firebase Functions — Local Development Environment Variables
#
# Copy this file to .env and fill in your Razorpay test credentials.
# NEVER commit the .env file to version control.
#
# For local development with Firebase emulators:
#   firebase emulators:start --only functions
#
# For production, these values are read from functions/.env during deployment.
# Secrets use Firebase Secret Manager (not .env files):
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET

# Razorpay API credentials (public — safe for client-side)
RAZORPAY_KEY_ID=rzp_test_xxxxx

# Razorpay plan IDs (server-only — create in Razorpay Dashboard)
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxxxx
RAZORPAY_PLAN_BUSINESS_MONTHLY=plan_xxxxx
RAZORPAY_PLAN_BUSINESS_YEARLY=plan_xxxxx
