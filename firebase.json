{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm run build",
      "node scripts/copy-ssr.js",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "*.log"
    ]
  },
  "hosting": {
    "public": "dist/business-demo-generator/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "ssr",
          "pinTag": true
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}