rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Authorization model:
    //   - Firebase Auth (Google sign-in)
    //   - Users have a profile in users/{uid} with role and plan fields
    //   - Admin = role == 'admin'
    //   - Users can only access their own data
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // User profiles
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile (on first login)
      allow create: if isOwner(userId);

      // Users can update safe fields only (displayName, photoURL)
      // Cannot update: role, plan, subscription, subscriptionStatus, createdAt, paymentCustomerId
      // paymentCustomerId is managed exclusively by Cloud Functions with Admin SDK
      allow update: if isOwner(userId) &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('plan' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscription' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('createdAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('paymentCustomerId' in request.resource.data.diff(resource.data).affectedKeys());

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // User usage subcollection
    // ------------------------------------------------------------------
    match /users/{userId}/usage/{month} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------------------------
    // businesses — server-authoritative for create and publish.
    //
    //   - Create: BLOCKED for clients (must use createBusinessServerFn)
    //   - Publish: BLOCKED for clients (must use publishBusinessServerFn)
    //   - Unpublish: allowed for owner/admin (status → draft)
    //   - Content updates: allowed for owner/admin
    //   - Read: published businesses public; owner sees all; admin sees all
    //   - Delete: owner or admin
    // ------------------------------------------------------------------
    match /businesses/{businessId} {
      // Public read: published only
      allow read: if resource.data.status == 'published';

      // Owner/Admin read: all (including drafts)
      allow read: if isOwner(resource.data.ownerId) || isAdmin();

      // Create: BLOCKED — must use createBusinessServerFn (Cloud Function)
      // Cloud Functions use Admin SDK and bypass these rules.
      allow create: if false;

      // Update: owner or admin, cannot publish directly, cannot touch publishedAt
      allow update: if (isOwner(resource.data.ownerId) || isAdmin()) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        // Cannot set status to 'published' — must use publishBusinessServerFn
        request.resource.data.status != 'published' &&
        // Cannot modify publishedAt — managed by server publish operation
        !('publishedAt' in request.resource.data.diff(resource.data).affectedKeys());

      // Delete: owner or admin
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ------------------------------------------------------------------
    // Webhook events — server-only, no client access
    // ------------------------------------------------------------------
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Everything else is denied by default.
  }
}