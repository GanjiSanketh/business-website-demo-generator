rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Authorization model:
    //   - Firebase Auth (Google sign-in)
    //   - Users have a profile in users/{uid} with role and plan fields
    //   - Admin = role == 'admin'
    //   - Users can only access their own data
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // User profiles
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile (on first login)
      allow create: if isOwner(userId);

      // Users can update safe fields only (displayName, photoURL)
      // Cannot update: role, plan, subscription, subscriptionStatus, createdAt
      allow update: if isOwner(userId) &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('plan' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscription' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // User usage subcollection
    // ------------------------------------------------------------------
    match /users/{userId}/usage/{month} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------------------------
    // businesses — the only collection used by the application.
    //
    //   - Public (anonymous) read: published businesses only
    //   - Owner read: own businesses (draft + published)
    //   - Admin read: all businesses
    //   - Create: authenticated users, ownerId must match request.auth.uid
    //   - Update: owner or admin
    //   - Delete: owner or admin
    //   - Legacy businesses (no ownerId): accessible only to admin
    // ------------------------------------------------------------------
    match /businesses/{businessId} {
      // Public read: published only
      allow read: if resource.data.status == 'published';

      // Owner/Admin read: all (including drafts)
      allow read: if isOwner(resource.data.ownerId) || isAdmin();

      // Create: authenticated user, ownerId must match
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      // Update: owner or admin, ownerId cannot be changed
      allow update: if (isOwner(resource.data.ownerId) || isAdmin()) &&
        request.resource.data.ownerId == resource.data.ownerId;

      // Delete: owner or admin
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Everything else is denied by default.
  }
}